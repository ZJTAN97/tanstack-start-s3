{
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".output"
  ],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2024"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
